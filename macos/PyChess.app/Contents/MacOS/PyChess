#!/usr/bin/env bash
#
# Launcher for the PyChess.app bundle produced by macos/install.sh.
#
# PyChess is a GTK/PyGObject application. On macOS the GTK typelibs, icon
# themes, GSettings schemas and GStreamer live under the Homebrew prefix, which
# is not on the default search paths. This launcher detects the Homebrew prefix,
# exports the environment variables GTK needs, and starts PyChess from the
# virtual environment bundled inside the app.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$APP_DIR/Contents/Resources/venv"

# Detect the Homebrew prefix (Apple Silicon vs Intel).
if [ -d "/opt/homebrew" ]; then
    BREW_PREFIX="/opt/homebrew"
elif [ -x "/usr/local/bin/brew" ]; then
    BREW_PREFIX="/usr/local"
elif command -v brew >/dev/null 2>&1; then
    BREW_PREFIX="$(brew --prefix)"
else
    BREW_PREFIX=""
fi

if [ -n "$BREW_PREFIX" ]; then
    export PATH="$BREW_PREFIX/bin:$PATH"
    export GI_TYPELIB_PATH="$BREW_PREFIX/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
    export DYLD_FALLBACK_LIBRARY_PATH="$BREW_PREFIX/opt/gettext/lib:$BREW_PREFIX/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
    # Both the bundled venv (icons/schemas installed by PyChess) and Homebrew
    # (Adwaita icon theme, GTK schemas) must be on the data search path.
    export XDG_DATA_DIRS="$VENV/share:$BREW_PREFIX/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
    export GSETTINGS_SCHEMA_DIR="$VENV/share/glib-2.0/schemas"
fi

if [ -x "$VENV/bin/pychess" ]; then
    exec "$VENV/bin/pychess" "$@"
else
    exec "$VENV/bin/python" -m pychess "$@"
fi
